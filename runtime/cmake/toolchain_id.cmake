# NXRT_TOOLCHAIN_ID (src/build/build.h): a hash of what the game module is made with - the lifter's sources, drippu's
# translator, the module's own sources and the builder's flags - so a runtime whose builder would make a different
# module refuses an older one. Run as a script at build time:
#   cmake -DROOT=<repo> -DLIST=<file listing the inputs, one repo-relative path per line> -DOUT=<header> -P toolchain_id.cmake
# Contents only, in sorted path order: the same on every host and checkout folder.
file(STRINGS "${LIST}" files)
list(SORT files)
set(all "")
foreach(f IN LISTS files)
    file(SHA256 "${ROOT}/${f}" h)
    string(APPEND all "${f} ${h}\n")
endforeach()
string(SHA256 id "${all}")
string(SUBSTRING "${id}" 0 16 id)
set(text "// generated by runtime/cmake/toolchain_id.cmake\n#define NXRT_TOOLCHAIN_ID \"${id}\"\n")
if (EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if (NOT old STREQUAL text)
    file(WRITE "${OUT}" "${text}")
endif()
